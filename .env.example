# Copy to .env and fill in. Never commit .env.

# Google Cloud project used to run (and bill) BigQuery jobs. The dataset is public; the free
# BigQuery sandbox covers this app.
GOOGLE_CLOUD_PROJECT=your-project-id

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: how much the model thinks (default high; medium is cheaper while developing)
# CLAUDE_EFFORT=medium

# Google Cloud credentials. Optional when running with Python on a machine where
# `gcloud auth application-default login` was run; required with Docker. It's a credentials JSON
# file (ideally a service-account key) encoded to one line; generate this line with:
#   python scripts/encode_google_credentials.py path/to/key.json
# GOOGLE_CREDENTIALS_BASE64=
